PORT=8787
# Z_HOST=127.0.0.1     # Interface to listen on. Anything but loopback requires a token (generated into Z_DATA_DIR/access.token if Z_TOKEN is unset).
Z_DATA_DIR=./.data
# Z_MASTER_KEY=        # 32 bytes, hex or base64. Generated on first run when unset.
# Z_TOKEN=             # Bearer token for /api. Set it whenever others can reach the server.
# Z_PUBLIC_URL=        # e.g. https://z.example.com — needed for webhook channels
# Z_PLUGINS=           # e.g. ./plugins/notes.ts,@acme/z-plugin
# Z_VAPID_SUBJECT=     # Web Push contact, e.g. mailto:you@example.com (defaults to Z_PUBLIC_URL when https)
# Z_ALLOW_PRIVATE_MCP=1 # let connectors reach MCP servers on localhost/your LAN (and plain http)
